{
  "outputDirectory": "dist",
  "framework": "vite",
  "buildCommand": "npm run build",
  "functions": {
    "api/bulk-disambiguate.js": {
      "maxDuration": 300
    },
    "api/clean-analyze.js": {
      "maxDuration": 120,
      "includeFiles": "public/{catalog.json,catalog-identities.json,catalog-source-v1.json}"
    },
    "api/shadow-normalize.js": {
      "maxDuration": 120
    },
    "api/ingest.js": {
      "maxDuration": 60,
      "includeFiles": "public/{catalog.json,catalog-identities.json,catalog-source-v1.json}"
    },
    "api/model-stats.js": {
      "maxDuration": 60,
      "includeFiles": "public/{catalog.json,catalog-identities.json,catalog-source-v1.json}"
    },
    "api/price-research.js": {
      "maxDuration": 60,
      "includeFiles": "public/{catalog.json,catalog-identities.json,catalog-source-v1.json}"
    },
    "api/reprocess.js": {
      "maxDuration": 60,
      "includeFiles": "public/{catalog.json,catalog-identities.json,catalog-source-v1.json}"
    },
    "api/build-missing-catalog.js": {
      "maxDuration": 60,
      "includeFiles": "public/{catalog.json,catalog-identities.json,catalog-source-v1.json}"
    },
    "api/debug-catalog.js": {
      "maxDuration": 60,
      "includeFiles": "public/{catalog.json,catalog-identities.json,catalog-source-v1.json}"
    }
  },
  "headers": [
    {
      "source": "/(parsedWatches|enriched_refs).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/extract", "destination": "/extract.html" },
    { "source": "/extract.html", "destination": "/extract.html" },
    { "source": "/viewer", "destination": "/watch_listings_viewer.html" },
    { "source": "/watch_listings_viewer.html", "destination": "/watch_listings_viewer.html" },
    { "source": "/data/(.*)", "destination": "/data/$1" },
    { "source": "/marketplace/(.*)", "destination": "/marketplace/$1" },
    { "source": "/((?!api/|marketplace/|data/|viewer|watch_listings_viewer.html).*)", "destination": "/index.html" }
  ]
}
