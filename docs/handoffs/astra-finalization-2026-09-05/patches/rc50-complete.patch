+      model: `Model-${id}`,
+      reference: `SYN-${id}`,
+      dial_color: 'Black',
+      year: 2024,
+      condition: 'Excellent',
+      intent: 'WTS',
+      intent_status: null,
+      title: `[SYNTHETIC] ${id}`,
+      description: `[SYNTHETIC] fixture row ${id}; contains no real-world data.`,
