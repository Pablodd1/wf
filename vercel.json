{
  "framework": "vite",
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/batch-process",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/generate-report",
      "schedule": "0 3 * * *"
    }
  ]
}
