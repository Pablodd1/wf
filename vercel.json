{
  "framework": "vite",
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/batch-process",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/generate-report",
      "schedule": "0 3 * * *"
    }
  ]
}
