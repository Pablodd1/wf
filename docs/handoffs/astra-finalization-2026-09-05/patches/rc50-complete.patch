+    { source_id: 'src_a', source_record_id: 'src_b', source_hash: VALID_HASH },
+    PROVENANCE_ERROR_CODES.PROVENANCE_IDENTITY_CONFLICT,
+  );
+  assertProvenanceThrow(
+    validV2({ proposal_source_id: 'different_src' }),
+    PROVENANCE_ERROR_CODES.PROVENANCE_IDENTITY_CONFLICT,
