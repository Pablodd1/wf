+const SEED_COLS = [
+  'contract_version', 'listing_id', 'parent_listing_id', 'child_index', 'source_id', 'source_hash',
+  'raw_message_id', 'raw_message_text', 'source_context_text', 'source_created_at', 'observed_at',
