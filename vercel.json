{
  "outputDirectory": "dist",
  "framework": "vite",
  "buildCommand": "npm run build",
  "functions": {
    "api/bulk-disambiguate.js": {
      "maxDuration": 300
    },
    "api/clean-analyze.js": {
      "maxDuration": 120
    },
    "api/price-research.js": {
      "maxDuration": 60
    },
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(parsedWatches|enriched_refs).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/extract", "destination": "/extract.html" },
    { "source": "/extract.html", "destination": "/extract.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
